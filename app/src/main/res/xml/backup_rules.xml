<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de backup automático para Android 11 ou inferior (ignorado a partir do Android 12).
    Nada deste app entra em backup: o banco local terá dados de saúde.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
